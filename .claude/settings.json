{
  "plansDirectory": ".crew/drafts",
"permissions": {
  "allow": [
    "Bash(echo:*)",
    "Bash(node .crew/bin/crew.mjs:*)",
    "Bash(git status:*)",
    "Bash(git diff:*)",
    "Bash(git log:*)",
    "Bash(git branch:*)",
    "Edit",
    "Write",
    "Bash(node:*)",
    "Bash(npm ci:*)",
    "Bash(npm run:*)",
    "Bash(npm test:*)",
    "Bash(npx vitest:*)",
    "Bash(npx tsc:*)",
    "Bash(git show:*)",
    "Bash(git rev-parse:*)",
    "Bash(git add:*)",
    "Bash(git commit:*)",
    "Bash(git merge:*)",
    "Bash(git worktree:*)",
    "Bash(cd:*)",
    "Bash(git -C:*)",
    "Bash(npm --prefix:*)",
    "Bash(grep:*)",
    "Bash(sed -n:*)",
    "Bash(ls:*)",
    "Bash(cat:*)",
    "Bash(head:*)",
    "Bash(tail:*)",
    "Bash(wc:*)",
    "Bash(rm .claude/worktrees/:*)"
  ],
  "deny": [
    "Read(./.env)",
    "Read(./**/.env)",
    "Read(./**/*.pem)",
    "Read(./**/*.key)",
    "Bash(git push:*)",
    "Bash(git -C * push*)",
    "Bash(git push --force:*)",
    "Bash(git commit --no-verify:*)",
    "Bash(git -C * commit --no-verify*)",
    "Bash(git reset --hard:*)",
    "Bash(git -C * reset --hard*)",
    "Bash(git clean:*)",
    "Bash(git -C * clean*)",
    "Bash(git branch -D:*)",
    "Bash(git -C * branch -D*)",
    "Bash(git checkout -- :*)",
    "Bash(git -C * checkout --*)",
    "Bash(git restore:*)",
    "Bash(git -C * restore*)",
    "Bash(rm -rf:*)",
    "Bash(rm -fr:*)",
    "Bash(rm -r:*)"
  ]
},
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" 2>/dev/null || exit 0; [ -f .crew/bin/crew.mjs ] && node .crew/bin/crew.mjs guard; exit 0"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" 2>/dev/null || exit 0; [ -f .crew/bin/crew.mjs ] && node .crew/bin/crew.mjs usage --hook >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.crew/bin/track_plan_draft.mjs\" ] && node \"$CLAUDE_PROJECT_DIR/.crew/bin/track_plan_draft.mjs\" --session; true"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" || exit 0; [ -d .githooks ] && [ \"$(git config core.hooksPath)\" != \".githooks\" ] && git config core.hooksPath .githooks && echo \"crew: activated .githooks\"; true"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" || exit 0; [ -f .crew/bin/crew.mjs ] && node .crew/bin/crew.mjs context; true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" 2>/dev/null || exit 0; [ -f .crew/bin/crew.mjs ] && node .crew/bin/crew.mjs activity --hook >/dev/null 2>&1; exit 0"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.crew/bin/track_plan_draft.mjs\" ] && node \"$CLAUDE_PROJECT_DIR/.crew/bin/track_plan_draft.mjs\"; true"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.crew/bin/format_on_edit.mjs\" ] && node \"$CLAUDE_PROJECT_DIR/.crew/bin/format_on_edit.mjs\"; true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" || exit 0; [ -f .crew/bin/crew.mjs ] && node .crew/bin/crew.mjs checkpoint --auto >/dev/null 2>&1; true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" || exit 0; [ -f .crew/bin/crew.mjs ] && node .crew/bin/crew.mjs checkpoint --auto >/dev/null 2>&1; true"
          }
        ]
      }
    ]
  }
}
