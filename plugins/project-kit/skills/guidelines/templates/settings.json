{
  "plansDirectory": ".project/drafts",
  "permissions": {
    "allow": [
      "Bash(python3 .project/bin/tracker.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Bash(git push --force:*)",
      "Bash(git commit --no-verify:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" || exit 0; [ -d .githooks ] && [ \"$(git config core.hooksPath)\" != \".githooks\" ] && git config core.hooksPath .githooks && echo \"project-kit: activated .githooks\"; [ -f .project/bin/tracker.py ] && python3 .project/bin/tracker.py current; true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.project/bin/format_on_edit.py\" ] && python3 \"$CLAUDE_PROJECT_DIR/.project/bin/format_on_edit.py\"; true"
          }
        ]
      }
    ]
  }
}
