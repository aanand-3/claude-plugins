#!/bin/sh
# project-kit: Conventional Commits. Scope is the plan ID on plan branches: feat(P-012): add login
msg=$(head -n1 "$1")
case "$msg" in
  Merge*|Revert*|fixup!*|squash!*|P-[0-9]*:*) exit 0 ;;
esac
if ! printf '%s' "$msg" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([A-Za-z0-9._/-]+\))?!?: .+'; then
  echo "✋ project-kit: commit message must follow Conventional Commits, e.g.:" >&2
  echo "     feat(P-012): add signup endpoint" >&2
  echo "     chore(tracker): plan P-013 password reset" >&2
  echo "   Got: $msg" >&2
  exit 1
fi
exit 0
